# Copy thành .env rồi điền key tạo ở https://testnet.binance.vision (đăng nhập GitHub → Generate HMAC_SHA256 Key)
# KHÔNG commit file .env
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision

# watch.py: topic ntfy để dashboard nhận lệnh khớp trực tiếp (công khai, nên đặt tên ngẫu nhiên). Tạo tên:
#   .venv\Scripts\python -c "import secrets; print('cbb-' + secrets.token_hex(10))"
NTFY_TOPIC=

# telegram_bot.py: token bot tạo qua @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
